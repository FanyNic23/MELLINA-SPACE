# --- Base de datos (PostgreSQL async). Para pruebas rápidas: sqlite+aiosqlite:///./astro.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/astro_health
AUTO_CREATE_TABLES=true

# --- OpenAI (copiloto GPT-4o con Structured Outputs + Whisper)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1

# --- STT: whisper | deepgram
STT_PROVIDER=whisper
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=es

# --- ElevenLabs (voz del casco)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- AWS (opcional: sin esto la Estación en Tierra es un sumidero simulado)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
SQS_QUEUE_URL=

# --- Simulador
SIM_AUTOSTART=false
SIM_TICK_SECONDS=2
SIM_MINUTES_PER_TICK=5

# --- Copiloto
COPILOT_COOLDOWN_SECONDS=60
AUDIO_DIR=./audio_out
LOG_LEVEL=INFO
