# ─────────────────────────────────────────────────────────────────────
# A-HAMS · Configuración del Edge Core
# Copia este archivo a backend/.env y ajusta los valores:
#   cp backend/.env.example backend/.env
# Las rutas relativas se resuelven desde la carpeta backend/.
# Todo funciona sin claves: los servicios en la nube son opcionales.
# ─────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO

# ── Servidor (lo usa backend/run.py) ─────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Recarga automática al editar código (desactívalo en el hardware de vuelo)
SERVER_RELOAD=true
# Orígenes permitidos, separados por comas. "*" permite abrir el frontend con file://
CORS_ORIGINS=*

# ── Base de datos de telemetría en tiempo real ───────────────────────
# SQLite no necesita servidor (ideal para el Edge). Para PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/astro_health
DATABASE_URL=sqlite+aiosqlite:///runtime/astro_health.db
AUTO_CREATE_TABLES=true

# ── Motor clínico SEWS (datos por días de misión) ────────────────────
TELEMETRY_DATA_PATH=../data/crew_telemetry_sample.json
EARTH_ONE_WAY_LATENCY_MINUTES=14.2

# ── Modo de IA ───────────────────────────────────────────────────────
# auto    = en línea (el más completo) cuando hay claves e internet; si no, offline.
# online  = intentar siempre en línea (si una API falla, igual responde offline).
# offline = nunca salir de la nave.
AI_MODE=auto

# ── Reconocimiento de voz ────────────────────────────────────────────
# auto = nube en línea (OpenAI si hay OPENAI_API_KEY, si no Deepgram) y Whisper local offline
# local | openai | deepgram (las opciones en la nube caen a Whisper local si fallan)
STT_PROVIDER=auto
STT_LANGUAGE=es
# Whisper local: tiny | base | small | medium | large-v3 (o ruta a un modelo propio)
WHISPER_MODEL=small
WHISPER_MODEL_DIR=models/whisper
# cpu | mps (GPU de Apple Silicon, experimental)
WHISPER_DEVICE=cpu
# int8 (rápido) | int8_float32 | float32 (más preciso, más lento)
WHISPER_COMPUTE_TYPE=int8
# false = nunca intentar descargar modelos (operación estrictamente offline)
WHISPER_ALLOW_DOWNLOAD=true
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ── OpenAI: IA del asistente y del copiloto + reconocimiento en la nube ─
# Sin clave: el asistente usa respuestas locales y el copiloto, reglas.
OPENAI_API_KEY=
# Vacío = API oficial. Sirve para un proxy o un servidor compatible con OpenAI.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1

# ── ElevenLabs: voz del copiloto y del asistente del reloj ───────────
# Sin clave, el reloj usa las voces del sistema.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── AWS (opcional: sin esto la Estación en Tierra es un sumidero simulado)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
SQS_QUEUE_URL=

# ── Audio generado por el copiloto ───────────────────────────────────
AUDIO_DIR=runtime/audio_out

# ── Simulador de telemetría ──────────────────────────────────────────
SIM_AUTOSTART=false
SIM_TICK_SECONDS=2
SIM_MINUTES_PER_TICK=5

# ── Copiloto ─────────────────────────────────────────────────────────
COPILOT_COOLDOWN_SECONDS=60
